# What the web's commands read from their environment. Vite does not load these from a file: set them in the shell or
# before a command (API_TARGET=http://localhost:8021 npm run dev). The values shown are the defaults. The app itself
# reads no variable at build time; it asks the API for everything.

# ── npm run dev (vite.config.ts) ───────────────────────────────────────────────────────────────────────────────────
# The dev server's port, and where it sends /api, /oauth and /.well-known (Django) and /mcp (the MCP server).
# WEB_PORT=5190
# API_TARGET=http://localhost:8020
# MCP_TARGET=http://localhost:8042

# ── npm run prerender (scripts/prerender.mjs): pages written with their words, read from a running API ──────────────
# API=http://localhost:8020
# SITE_URL=http://localhost:5190
# NAMED=1 writes the named texts only; ONLY=/ma/loi/2025/50-25 one text; LIMIT=20 the first texts; LAWS=0 no law;
# LANDING=0 no landing page.
# NAMED=
# ONLY=
# LIMIT=0
# LAWS=1
# LANDING=1
# The API asked through an ssh connection's socket instead (deploy/deploy.sh sets both).
# API_SSH=
# API_SSH_SOCKET=

# ── scripts/ssr-server.mjs: the service that draws a law's page for Django ─────────────────────────────────────────
# SSR_PORT=8043
# SSR_QUEUE=8
# SSR_ENTRY=dist-ssr/entry-server.js

# ── npm run blog:posters (scripts/blog-posters.mjs) ──────────────────────────────────────────────────────────────
# The posts to draw, separated by spaces; empty, every post.
# SLUGS=

# ── npm run e2e:* (e2e/*.e2e.mjs, Playwright; both dev servers running) ───────────────────────────────────────────
# The site under test, a folder for screenshots, and a browser channel where Playwright's own is not installed.
# BASE_URL=http://localhost:5190
# SHOTS=
# CHANNEL=chrome
# e2e:letters: the folder Django writes its letters to (its EMAIL_FILE_PATH, with the file backend).
# LETTERS=
# e2e:connect: an account with a proven email.
# LAW_E2E_USER=
# LAW_E2E_PASSWORD=
# e2e:talk: the demo seeds' password (back/.env.example, DEMO_PASSWORD).
# DEMO_PASSWORD=
# e2e:smoke, e2e:measure: the built site's folder (default web/dist), served by Vite's preview on WEB_PORT (default:
# any free port). e2e:smoke also needs the address Django answers on, and LETTERS (tools/ci/smoke.sh sets them all).
# WEB_DIST=
# DJANGO=
# e2e:access, e2e:desk: run with the backend's OPEN_DATA=request and its DATABASE_URL.
# OPEN_DATA=request
# DATABASE_URL=

# ── node --test tests/*.test.ts ──────────────────────────────────────────────────────────────────────────────────────
# CI=true runs tests/today.test.ts's time-zone check whatever this Node's data (CI sets it; elsewhere a Node
# whose data is older than 2026c skips it).
# CI=

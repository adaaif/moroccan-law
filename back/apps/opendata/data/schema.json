{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "schema.json",
 "title": "The database of @SITE@, format @FORMAT@: one line of each file",
 "description": "Each line of a .jsonl.gz file of an edition is one JSON object, valid against the definition named like the file: texts.jsonl.gz against $defs/texts, versions.jsonl.gz against $defs/versions, and so on. README.md says what each field means.",
 "$defs": {
  "day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
  "day_or_null": {"anyOf": [{"$ref": "#/$defs/day"}, {"type": "null"}]},
  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "sha256_or_null": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
  "string_or_null": {"type": ["string", "null"]},
  "integer_or_null": {"type": ["integer", "null"]},
  "kind": {
   "description": "What a version's words are. Only as_published is the official text.",
   "enum": ["as_published", "machine", "checked", "sgg", "adala", "dgi", "bill", "translation"]
  },
  "article": {
   "type": "object",
   "additionalProperties": false,
   "required": ["eid", "label", "number", "heading_path", "path", "page", "body"],
   "properties": {
    "eid": {"type": "string"},
    "label": {"type": "string"},
    "number": {"type": "string"},
    "heading_path": {"type": "array", "items": {"type": "string"}},
    "path": {"type": "string"},
    "page": {"$ref": "#/$defs/integer_or_null"},
    "body": {"type": "string"}
   }
  },
  "version": {
   "type": "object",
   "additionalProperties": false,
   "required": ["kind", "language", "valid_from", "valid_to", "translated_from", "file", "pages"],
   "properties": {
    "kind": {"$ref": "#/$defs/kind"},
    "language": {"enum": ["ar", "fr"]},
    "valid_from": {"$ref": "#/$defs/day"},
    "valid_to": {"$ref": "#/$defs/day_or_null"},
    "translated_from": {"enum": ["ar", "fr", null]},
    "file": {
     "anyOf": [
      {"type": "null"},
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["source", "sha256"],
       "properties": {"source": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
      }
     ]
    },
    "pages": {"$ref": "#/$defs/string_or_null"}
   }
  },
  "texts": {
   "type": "object",
   "additionalProperties": false,
   "required": ["akn_uri", "path", "type", "number", "title", "signed_on", "signed_on_hijri", "authority", "status",
                "source", "version", "citation", "articles", "amends", "cites"],
   "properties": {
    "akn_uri": {"type": "string"},
    "path": {"type": "string"},
    "type": {"type": "string"},
    "number": {"type": "string"},
    "title": {"type": "string"},
    "signed_on": {"$ref": "#/$defs/day_or_null"},
    "signed_on_hijri": {"type": "string"},
    "authority": {"type": "string"},
    "status": {"enum": ["in_force", "partly_repealed", "repealed", "not_yet_in_force", "unknown"]},
    "source": {
     "anyOf": [
      {"type": "null"},
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["issue", "edition", "date", "page", "sha256"],
       "properties": {
        "issue": {"type": "string"},
        "edition": {"type": "string"},
        "date": {"$ref": "#/$defs/day"},
        "page": {"$ref": "#/$defs/integer_or_null"},
        "sha256": {"$ref": "#/$defs/sha256_or_null"}
       }
      }
     ]
    },
    "version": {"$ref": "#/$defs/version"},
    "citation": {"type": "string"},
    "articles": {"type": "array", "items": {"$ref": "#/$defs/article"}},
    "amends": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "article", "action", "takes_effect", "state"],
      "properties": {
       "target": {"type": "string"},
       "article": {"type": "string"},
       "action": {"type": "string"},
       "takes_effect": {"$ref": "#/$defs/day_or_null"},
       "state": {"enum": ["checked", "confirmed", "read"]}
      }
     }
    },
    "cites": {"type": "array", "items": {"type": "string"}}
   }
  },
  "versions": {
   "type": "object",
   "additionalProperties": false,
   "required": ["akn_uri", "path", "version", "articles"],
   "properties": {
    "akn_uri": {"type": "string"},
    "path": {"type": "string"},
    "version": {"$ref": "#/$defs/version"},
    "articles": {"type": "array", "items": {"$ref": "#/$defs/article"}}
   }
  },
  "french": {
   "type": "object",
   "additionalProperties": false,
   "required": ["akn_uri", "path", "type", "number", "title", "signed_on", "source", "consolidated_to", "articles"],
   "properties": {
    "akn_uri": {"type": "string"},
    "path": {"type": "string"},
    "type": {"type": "string"},
    "number": {"$ref": "#/$defs/string_or_null"},
    "title": {"type": "string"},
    "signed_on": {"$ref": "#/$defs/day_or_null"},
    "source": {
     "type": "object",
     "additionalProperties": false,
     "required": ["edition", "issue", "date", "pages", "sha256"],
     "properties": {
      "edition": {"const": "translation_fr"},
      "issue": {"type": "string"},
      "date": {"$ref": "#/$defs/day"},
      "pages": {"$ref": "#/$defs/string_or_null"},
      "sha256": {"$ref": "#/$defs/sha256_or_null"}
     }
    },
    "consolidated_to": {"$ref": "#/$defs/day_or_null"},
    "articles": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "number", "page", "body"],
      "properties": {
       "label": {"type": "string"},
       "number": {"type": "string"},
       "page": {"$ref": "#/$defs/integer_or_null"},
       "body": {"type": "string"}
      }
     }
    }
   }
  },
  "changes": {
   "type": "object",
   "additionalProperties": false,
   "required": ["target", "target_path", "article", "action", "by", "issue", "page", "published_on", "takes_effect",
                "effective_rule", "source", "state"],
   "properties": {
    "target": {"type": "string"},
    "target_path": {"type": "string"},
    "article": {"$ref": "#/$defs/string_or_null"},
    "action": {"enum": ["modified", "added", "replaced", "repealed", "words"]},
    "by": {
     "type": "object",
     "additionalProperties": false,
     "required": ["akn_uri", "path", "kind", "number", "article"],
     "properties": {
      "akn_uri": {"$ref": "#/$defs/string_or_null"},
      "path": {"$ref": "#/$defs/string_or_null"},
      "kind": {"type": "string"},
      "number": {"type": "string"},
      "article": {"$ref": "#/$defs/string_or_null"}
     }
    },
    "issue": {"$ref": "#/$defs/string_or_null"},
    "page": {"$ref": "#/$defs/integer_or_null"},
    "published_on": {"$ref": "#/$defs/day_or_null"},
    "takes_effect": {"$ref": "#/$defs/day_or_null"},
    "effective_rule": {"enum": ["publication", "stated", "after", "condition", null]},
    "source": {"enum": ["reading", "sgg", "adala", "dgi", "bill"]},
    "state": {"enum": ["checked", "confirmed", "read", "conflict", "unclear", "proposed", null]}
   }
  },
  "issues": {
   "type": "object",
   "additionalProperties": false,
   "required": ["edition", "number", "suffix", "key", "date", "hijri_date", "path", "first_page", "copy_of", "file"],
   "properties": {
    "edition": {"enum": ["general_ar", "translation_fr", "conventions_ar", "conventions_fr", "announcements_legal",
                         "announcements_land"]},
    "number": {"type": "integer"},
    "suffix": {"$ref": "#/$defs/string_or_null"},
    "key": {"type": "string"},
    "date": {"$ref": "#/$defs/day"},
    "hijri_date": {"$ref": "#/$defs/string_or_null"},
    "path": {"type": "string"},
    "first_page": {"$ref": "#/$defs/integer_or_null"},
    "copy_of": {"$ref": "#/$defs/string_or_null"},
    "file": {
     "anyOf": [
      {"type": "null"},
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["sha256", "pages", "bytes", "url"],
       "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "pages": {"$ref": "#/$defs/integer_or_null"},
        "bytes": {"type": "integer"},
        "url": {"$ref": "#/$defs/string_or_null"}
       }
      }
     ]
    }
   }
  },
  "aliases": {
   "type": "object",
   "additionalProperties": false,
   "required": ["alias", "alias_path", "akn_uri", "path", "reason"],
   "properties": {
    "alias": {"type": "string"},
    "alias_path": {"type": "string"},
    "akn_uri": {"type": "string"},
    "path": {"type": "string"},
    "reason": {"enum": ["moved", "merged", "dahir", "copy", "twin"]}
   }
  }
 }
}

,{"n":"78","g":"penalties"},{"n":"79","g":"penalties"},{"n":"80","g":"penalties"},{"n":"81","g":"penalties"},{"n":"82","g":"penalties"},{"n":"83","g":"penalties"},{"n":"84","g":"penalties"},{"n":"85","g":"penalties"},{"n":"86","g":"penalties"},{"n":"87","g":"penalties"},{"n":"88","g":"penalties"},{"n":"88-1","g":"penalties"},{"n":"88-2","g":"penalties"},{"n":"88-3","g":"penalties"},{"n":"89","g":"penalties"},{"n":"90","g":"penalties"},{"n":"91","g":"penalties"},{"n":"92","g":"penalties"},{"n":"93","g":"penalties"},{"n":"94","g":"penalties"},{"n":"95","g":"penalties"},{"n":"96","g":"penalties"},{"n":"97","g":"penalties"},{"n":"98","g":"penalties"},{"n":"99","g":"penalties"},{"n":"100","g":"penalties"},{"n":"101","g":"penalties"},{"n":"102","g":"penalties"},{"n":"103","g":"penalties"},{"n":"104","g":"penalties"},{"n":"105","g":"penalties"},{"n":"106","g":"penalties"},{"n":"107","g":"penalties"},{"n":"108","g":"penalties"},{"n":"109","g":"penalties"},{"n":"110","g":"applying"},{"n":"111","g":"applying"},{"n":"112","g":"applying"},{"n":"113","g":"applying"},{"n":"114","g":"applying"},{"n":"115","g":"applying"},{"n":"116","g":"applying"},{"n":"117","g":"applying"},{"n":"118","g":"applying"},{"n":"119","g":"applying"},{"n":"120","g":"applying"},{"n":"121","g":"applying"},{"n":"122","g":"applying"},{"n":"123","g":"applying"},{"n":"124","g":"applying"},{"n":"125","g":"applying"},{"n":"126","g":"applying"},{"n":"127","g":"applying"},{"n":"128","g":"applying"},{"n":"129","g":"applying"},{"n":"130","g":"applying"},{"n":"131","g":"applying"},{"n":"132","g":"applying"},{"n":"133","g":"applying"},{"n":"134","g":"applying"},{"n":"135","g":"applying"},{"n":"136","g":"applying"},{"n":"137","g":"applying"},{"n":"138","g":"applying"},{"n":"139","g":"applying"},{"n":"140","g":"applying"},{"n":"141","g":"applying"},{"n":"142","g":"applying"},{"n":"143","g":"applying"},{"n":"144","g":"applying"},{"n":"145","g":"applying"},{"n":"146","g":"applying"},{"n":"147","g":"applying","clause":"إذا
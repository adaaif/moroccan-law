# Copy to back/.env and change what you need. The values shown are the defaults, or a safe example where the default
# is empty. Development runs on SQLite with none of this; the fetchers need FETCH_USER_AGENT before they run.
# Production (config.settings.prod) needs SECRET_KEY, ALLOWED_HOSTS, the POSTGRES_* lines and REDIS_URL, and
# `manage.py check --deploy` refuses a server without its own FETCH_USER_AGENT and DEFAULT_FROM_EMAIL. Quote a value
# that holds spaces, brackets or <>: the server's scripts read its .env with the shell (deploy/deploy.sh, nightly.sh).

# ── Django ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# Which settings: config.settings.dev (manage.py's default), config.settings.prod (wsgi.py's), config.settings.test.
# DJANGO_SETTINGS_MODULE=config.settings.dev
# 50+ random characters in production, where the development key is refused.
# SECRET_KEY=change-me-to-50-random-characters
# Production only: the host names the site answers to, comma-separated.
# ALLOWED_HOSTS=example.org,www.example.org
# The site's own address: link previews, sitemaps, the open data's references, the OAuth issuer.
# SITE_URL=http://localhost:5190
# The site's Latin name: the letters' sender, the assistants' connector, saved files.
# SITE_NAME=3adala
# The built web app, whose index.html Django answers a law's address with.
# WEB_DIST=../web/dist

# ── Database ───────────────────────────────────────────────────────────────────────────────────────────────────────
# Development and scripts: one URL (SQLite in back/db.sqlite3 without it). Search needs PostgreSQL with ParadeDB.
# DATABASE_URL=postgres://law:law@localhost:5432/law
# Production: the parts, read by config.settings.prod.
# POSTGRES_DB=law
# POSTGRES_USER=law
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Production: seconds a worker keeps its connection.
# CONN_MAX_AGE=600
# The tests: a PostgreSQL server with ParadeDB for the search tests (in-memory SQLite without it; they skip).
# TEST_DATABASE_URL=postgres://law:law@localhost:5432/law_test

# ── Caches ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# The shared cache: request limits and kept answers. Required in production; without it development keeps limits in
# the process and keeps no answer. For example: docker run -d -p 127.0.0.1:6379:6379 redis:8-alpine
# REDIS_URL=redis://127.0.0.1:6379/0
# The limits' counts in a store of their own that never evicts (deploy/compose.yml's «counters»); unset, REDIS_URL.
# COUNTERS_REDIS_URL=redis://127.0.0.1:6382/0
# The largest answer the answers' cache keeps, in bytes.
# ANSWERS_KEPT_MOST=2000000

# ── Files ──────────────────────────────────────────────────────────────────────────────────────────────────────────
# The corpus on disk (fetched files, page images, work files, ledgers, kept lists): outside git.
# CORPUS_DIR=../data
# What readers send (voices, pictures): outside git and outside any public folder.
# UPLOADS_DIR=../uploads
# DB-IP's free ASN database, the network operators of the day of reading's READING_OPERATOR_CEILING
# (manage.py fetch_geoip); default CORPUS_DIR/geo.
# GEOIP_DIR=../data/geo
# The database's editions' folder (default CORPUS_DIR/open), and where access stands: closed (nobody), request (the
# database and the keyed API are given to an account the staff accepted) or open (the files to anyone).
# OPEN_DATA_DIR=../data/open
# OPEN_DATA=closed
# In production nginx sends an edition's files from its internal location (deploy/nginx.conf); empty, Django streams them.
# OPEN_DATA_ACCEL=/_open
# Who is written to when a request for access arrives (comma-separated addresses); empty, nobody.
# ACCESS_LETTER_TO=
# Pictures drawn on request: how many at once in the whole site, new ones a minute from one address, bytes a folder.
# DRAWING_AT_ONCE=3
# DRAWING_PER_MINUTE=30
# DRAWN_FOLDER_MOST=2000000000

# ── The pipeline ───────────────────────────────────────────────────────────────────────────────────────────────────
# Required before any fetcher runs: your project's name and a page that says who runs it. Empty, the fetchers refuse
# to start.
# FETCH_USER_AGENT='example/1 (+https://example.org/about)'
# The API key for reading scans and structuring texts (Anthropic). Empty: nothing is sent, and the site needs none.
# ANTHROPIC_API_KEY=
# The total the pipeline may spend, in dollars: a batch that could pass it is refused before it is sent.
# OCR_BUDGET_USD=10.0
# The models allowed, comma-separated; empty allows every priced model.
# LLM_MODELS_ALLOWED=claude-haiku-5-5
# The structuring ledger, under CORPUS_DIR (a .jsonl one is appended to).
# LLM_LEDGER=reports/llm_ledger.json
# Batches: the largest batch in bytes, the longest wait for one in seconds, requests per structuring batch (0: all).
# OCR_BATCH_BYTES=64000000
# BATCH_WAIT_S=3600
# LLM_BATCH_REQUESTS=0
# The archive's column width in pixels, and the name of its key file.
# ARCHIVE_COLUMN_WIDTH=3192
# ARCHIVE_KEY_NAME=key

# ── Search ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# Search by meaning: the model's name and folder (ONNX and its tokenizer), the model server (manage.py serve_models),
# and whether search uses it (without the server, BM25 alone).
# SEARCH_MODEL=bge-m3
# SEARCH_MODEL_DIR=../models/bge-m3-int8
# SEARCH_MODEL_URL=http://127.0.0.1:8090
# SEARCH_MEANING=True
# BM25's share when its scores and the meaning's are summed; a negative value fuses by reciprocal rank.
# SEARCH_FUSION_WEIGHT=0.5
# Which texts found by meaning alone come after the words' ('rules', 'all' or ''), and the cosine they need.
# SEARCH_MEANING_AFTER=rules
# SEARCH_MEANING_FLOOR=0.0
# Switches being measured: the lemma table, the thesaurus's words, the answer box, a question inside a named code.
# SEARCH_LEMMAS=False
# SEARCH_THESAURUS=False
# SEARCH_ANSWER=False
# SEARCH_INSIDE=False

# ── What readers see ───────────────────────────────────────────────────────────────────────────────────────────────
# Drafts (topics' items, situations) shown, marked as drafts. Development shows them.
# SHOW_DRAFTS=False
# A password in front of the whole site; empty, none.
# GATE_PASSWORD=
# The address the about page gives readers to write to; empty hides the line.
# CONTACT_EMAIL=contact@example.org
# The public repository of the site's code, given on the about page and «ساهم»; empty until it is published.
# SOURCE_URL=
# How many people each doubtful word of «ساهم» is asked of.
# WORD_ANSWERS=3
# The day of reading: articles and printed pages a browser is given a day (0 turns it off), the passes the check gives
# one address a day, and a ceiling for one network operator's browsers together (0: none).
# READING_BUDGET=3000
# READING_PASSES=10
# READING_OPERATOR_CEILING=0
# Cloudflare Turnstile, the check past a day's reading; without the keys the reader is told to come back tomorrow.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# What the site counts (POST /api/measure/, tasks and never people); closed, it answers 204 and writes nothing.
# ANALYTICS_OPEN=True
# The days the measures' events are kept before only their day counts are left.
# ANALYTICS_DAYS=90
# nginx's access log, read each night by count_machines: the file rotated the night before last, last night's, today's.
# NGINX_LOGS=/var/log/nginx/law/access.log.2.gz,/var/log/nginx/law/access.log.1,/var/log/nginx/law/access.log
# Who gets the Monday letter of the week's counts, addresses separated by commas; empty, no letter is sent.
# ANALYTICS_LETTER_TO=team@example.org

# ── Accounts and letters ───────────────────────────────────────────────────────────────────────────────────────────
# New accounts. Off by default; development opens them (REGISTRATION_OPEN=False closes them there).
# REGISTRATION_OPEN=False
# Sign-in with Google: the web client's id, and others (a phone's), comma-separated. Empty: off.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_EXTRA_CLIENT_IDS=
# Letters through Resend when its key is set; else SMTP below, or the backend named (development prints them).
# RESEND_API_KEY=
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_FILE_PATH=
# EMAIL_HOST=localhost
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# The letters' sender. Its default, at localhost, is refused by `check --deploy`: a server sets its own, such as
# example <noreply@example.org>.
# DEFAULT_FROM_EMAIL='3adala <noreply@localhost>'

# ── The discussion ─────────────────────────────────────────────────────────────────────────────────────────────────
# Whether readers may write. Off by default; development opens it.
# DISCUSSION_OPEN=False
# The development's demo people shown (the seeds); off by default, on in development. recount_discussions after
# changing it.
# SHOW_DEMO_PEOPLE=False
# The demo seeds' password (seed_demo_talk); empty, a random one.
# DEMO_PASSWORD=
# The check before publishing: 'model' asks CHECK_MODEL, 'pass' publishes on the fixed patterns alone, 'markers'
# stands in for the model while developing. Development without a key uses 'pass'.
# DISCUSSION_CHECK=model
# CHECK_MODEL=claude-haiku-5-5
# CHECK_TIMEOUT_S=6.0
# CHECK_BUDGET_USD=20.0
# Voices and pictures in the topics. Off by default, in development too.
# DISCUSSION_MEDIA=False
# Seconds between two of the discussion's letters (send_notice_letters).
# NOTICE_LETTER_PACE_S=0.5

# ── The assistants (OAuth and MCP) ─────────────────────────────────────────────────────────────────────────────────
# The OAuth issuer and the MCP resource: the site's address and its /mcp.
# OAUTH_ISSUER=http://localhost:5190
# MCP_RESOURCE=http://localhost:5190/mcp
# The hosts whose client metadata the server fetches, comma-separated.
# OAUTH_METADATA_HOSTS=claude.ai,claude.com,chatgpt.com,openai.com
# 'open': no sign-in needed; 'required': every call needs an account.
# MCP_AUTH=open
# The MCP service's threads (each holds a database connection while it works).
# MCP_THREADS=4
# Per account: calls a minute and a day, article bodies a day.
# MCP_QUOTA_MINUTE=20
# MCP_QUOTA_DAY=300
# MCP_QUOTA_ARTICLES=600
# Without an account: a platform's users together, an hour.
# MCP_PLATFORM_MINUTE=600
# MCP_PLATFORM_HOUR=5000
# MCP_PLATFORM_ARTICLES=10000
# One conversation subject inside its platform, an hour.
# MCP_SUBJECT_MINUTE=20
# MCP_SUBJECT_HOUR=150
# MCP_SUBJECT_ARTICLES=300
# A direct caller, a day.
# MCP_ADDRESS_MINUTE=30
# MCP_ADDRESS_DAY=1000
# MCP_ADDRESS_ARTICLES=2000

# ── Search engines ─────────────────────────────────────────────────────────────────────────────────────────────────
# The drawing service for a law's page (web/scripts/ssr-server.mjs); empty, the head alone (production: 127.0.0.1:8043).
# SSR_URL=
# SSR_TIMEOUT=3.0
# SSR_MOST=1000000
# SSR_REST=10.0
# 'open' or 'closed'; the day it opened (YYYY-MM-DD) sets the sitemaps' waves, or SITEMAP_WAVE says the wave.
# INDEXING=closed
# INDEXING_OPENED=
# SITEMAP_WAVE=0
# SITEMAPS_DIR=../data/seo/sitemaps
# IndexNow's key; empty, one is derived from SECRET_KEY.
# INDEXNOW_KEY=
